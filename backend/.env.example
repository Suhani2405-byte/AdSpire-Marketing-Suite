# Copy to backend/.env and fill in. Never commit the real .env.
GEMINI_API_KEY=
SECRET_KEY=change-me-to-a-long-random-string
# Leave empty locally to use SQLite. On Render use a Postgres URL (Neon / Supabase).
DATABASE_URL=
# Comma-separated emails that become admin when they register (the first account is admin anyway)
ADMIN_EMAILS=
# Optional image providers
HF_TOKEN=
POLLINATIONS_API_KEY=
# Optional free keys for real HD product photos (pexels.com/api, unsplash.com/developers)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Free real photos (instant key at pixabay.com/api/docs after login)
PIXABAY_API_KEY=
# Free FLUX AI images without watermark (dash.cloudflare.com -> Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
